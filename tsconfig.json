{
  "compileOnSave": false,
  "compilerOptions": {
    "module": "es2020",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "useDefineForClassFields": false,
    "ignoreDeprecations": "6.0",
    "strict": false
  },

  "angularCompilerOptions": {
    "strictTemplates": true
  }
}

